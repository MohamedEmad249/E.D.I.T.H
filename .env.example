# Copy to .env and edit. Every value is optional; these are the defaults.

# Ollama (the local chat model server)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct
# qwen2.5:0.5b-instruct is ~2x faster but noticeably less accurate.

MAX_NEW_TOKENS=384      # longest answer, in tokens
NUM_CTX=4096            # context window: prompt + answer must fit

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

UPLOAD_MAX_MB=30
SESSIONS_FILE=chat_sessions.json
